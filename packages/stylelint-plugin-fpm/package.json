{
  "name": "stylelint-plugin-fpm",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "description": "Stylelint custom rules for the fpm CSS convention.",
  "keywords": [
    "css",
    "fpm",
    "stylelint",
    "stylelint-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zk33/fpm-css.git",
    "directory": "packages/stylelint-plugin-fpm"
  },
  "homepage": "https://zk33.github.io/fpm-css/",
  "bugs": {
    "url": "https://github.com/zk33/fpm-css/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "pnpm run build",
    "test": "pnpm run build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
  "peerDependencies": {
    "stylelint": ">=17 <18"
  },
  "dependencies": {
    "postcss-selector-parser": "^7.1.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "jest": "^30.4.2",
    "jest-preset-stylelint": "^9.2.0",
    "postcss": "^8.5.16",
    "stylelint": "^17.14.0",
    "typescript": "^6.0.3"
  }
}
