{
  "name": "stylelint-config-fpm",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "description": "Shareable Stylelint config for the fpm CSS convention.",
  "keywords": [
    "css",
    "fpm",
    "stylelint",
    "stylelint-config"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zk33/fpm-css.git",
    "directory": "packages/stylelint-config-fpm"
  },
  "homepage": "https://zk33.github.io/fpm-css/",
  "bugs": {
    "url": "https://github.com/zk33/fpm-css/issues"
  },
  "type": "commonjs",
  "main": "./index.cjs",
  "exports": {
    ".": "./index.cjs"
  },
  "files": [
    "index.cjs",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --check index.cjs",
    "lint": "pnpm run build",
    "test": "pnpm --filter stylelint-plugin-fpm build && pnpm run build && stylelint \"fixtures/valid/**/*.css\" --config ../../stylelint.config.cjs --allow-empty-input"
  },
  "peerDependencies": {
    "stylelint": ">=17 <18"
  },
  "dependencies": {
    "stylelint-config-standard": "^40.0.0",
    "stylelint-plugin-fpm": "workspace:*"
  },
  "devDependencies": {
    "stylelint": "^17.14.0"
  }
}
